# --- Demo container admin (only used by docker-compose and scripts/seed.py) ---
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!

# --- Connection used by the MCP server ---
DB_HOST=localhost
DB_PORT=1433
DB_NAME=CompanyDB

# Read-only login: every SELECT the agents run goes through this one.
DB_READER_USER=agent_reader
DB_READER_PASSWORD=Reader_Str0ng!

# Writer login: only used after a write has been previewed and confirmed.
# Leave empty to disable writes entirely.
DB_WRITER_USER=agent_writer
DB_WRITER_PASSWORD=Writer_Str0ng!

# Tables the agents are allowed to modify (comma-separated, schema.table).
WRITABLE_TABLES=sales.customers,sales.orders,inventory.products

MAX_ROWS=500
QUERY_TIMEOUT_SECONDS=30
